<div class="display1" *ngIf="items && items.length > 0">
  <div *ngFor="let item of items; let i = index" class="accordion-item">

    <button class="toggle-btn"
      [class.highlight-current]="item.highlightCurrentClick || item.highlightCurrentHover"
      [class.highlight-top-next]="item.highlightTopDuePrevClick || item.highlightTopDuePrevHover"

      [class.dimmed]="hasActiveOrHover() &&
        !(item.highlightCurrentClick || item.highlightCurrentHover ||
          item.highlightTopDuePrevClick || item.highlightTopDuePrevHover)"

      (click)="toggle(i)"
      (mouseenter)="hover(i)"
      (mouseleave)="leaveHover()">

      <div class="left-group">

        <span
          *ngIf="item.route"
          class="link-btn"
          (click)="item && goToPage(item); $event.stopPropagation()">
        </span>
        <span class="label-clickable"
          (click)="goToPageOnly(item); $event.stopPropagation()">
          {{ item.label }}
        </span>
        <span class="status-badge"
              *ngIf="item.status"
              [ngClass]="{
                'in-progress': item.status === 'In Progress',
                'completed': item.status === 'Completed',
                'blocked': item.status === 'Blocked'
              }">
          {{ item.status }}
        </span>
        <!-- <div class="start-date" *ngIf="item.startDate">
          Start Date: {{ item.startDate | date:'medium' }}
        </div>    -->
        <!-- START DATE -->
<div class="meta" *ngIf="item.startDate">
 Start: {{ item.startDate | date:'medium' }}
</div>
<!-- END DATE -->
<div class="meta" *ngIf="item.endDate">
 End: {{ item.endDate | date:'medium' }}
</div>
<!-- DURATION -->
<div class="meta" *ngIf="item.startDate && item.endDate">
 Duration: {{ getDuration(item.startDate, item.endDate) }}
</div>
<!-- LAST UPDATED -->
<div class="meta" *ngIf="item.lastUpdated">
 Updated: {{ item.lastUpdated | date:'medium' }}
</div>
      </div>
      <span class="sign">{{ item.isExpanded ? '-' : '+' }}</span>
    </button>

    <div class="content" *ngIf="item.isExpanded">

  <div class="content-wrapper">

    <!-- LEFT: TEXT -->
    <div class="text-container">
      <p class="text" *ngIf="item.text">{{ item.text }}</p>

      <ng-container *ngIf="item.sections">
        <div *ngFor="let section of item.sections">
          <p class="text">{{ section.text }}</p>

          <ul *ngIf="section.points" class="purple-bullets">
            <li *ngFor="let point of section.points">{{ point }}</li>
          </ul>
        </div>
      </ng-container>
    </div>

    <!-- RIGHT: IMAGE -->
    <div class="image-container">
      <img *ngIf="item.image" [src]="item.image" alt="{{ item.label }}" />

      <button
        *ngIf="item.route"
        class="link-btn-below"
        (click)="goToPage(item)">
        Start
      </button>
    </div>

  </div>
  </div>